# Google AI API Key
# Obtén tu API key en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=tu_api_key_aqui

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URL pública del servidor, sin barra final.
# IMPORTANTE para eventos: si se deja vacía, el QR de descarga apunta al host de
# la petición (por ejemplo "localhost"), y entonces NO funciona al escanearlo
# desde un celular. Pon aquí la IP de la red local o el dominio público.
# Ejemplos:
#   PUBLIC_URL=http://192.168.1.50:3000
#   PUBLIC_URL=https://comics.midominio.com
PUBLIC_URL=

# Carpeta donde se guardan los cómics y el archivo de historias.
# Si se deja vacía se usa la raíz del proyecto.
# EN RENDER es obligatorio si quieres conservar las historias: monta un Disk y
# pon aquí su Mount Path, porque el disco del contenedor se borra en cada deploy.
#   STORAGE_DIR=/var/data
STORAGE_DIR=
